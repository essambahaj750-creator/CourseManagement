{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=../coursemanagement.db"
  },
  "JwtSettings": {
    "IssueToken": false,
    "Secret": "",
    "Issuer": "CourseManagementAPI",
    "Audience": "CourseManagementClient",
    "ExpiryHours": 2
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Swagger": {
    "Enabled": false
  },
  "Database": {
    "ApplyMigrations": false
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "FileUploads": {
    "RootPath": "../CourseManagement.Uploads",
    "MaxVideoBytes": 536870912,
    "MaxAttachmentBytes": 52428800,
    "MaxCoverImageBytes": 5242880,
    "AllowedVideoExtensions": [ ".mp4", ".webm", ".mov", ".m4v" ],
    "AllowedAttachmentExtensions": [ ".pdf", ".doc", ".docx", ".ppt", ".pptx", ".xls", ".xlsx", ".zip", ".txt" ],
    "AllowedCoverImageExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
