{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=coursemanagement.db"
  },
  "JwtSettings": {
    "IssueToken": false,
    "Secret": "",
    "Issuer": "CourseManagementAPI",
    "Audience": "CourseManagementClient",
    "ExpiryHours": 2
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Swagger": {
    "Enabled": false
  },
  "Database": {
    "ApplyMigrations": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
