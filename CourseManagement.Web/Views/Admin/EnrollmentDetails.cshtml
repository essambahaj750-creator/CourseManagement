@model EnrollmentDto
@{
    ViewData["Title"] = "تفاصيل التسجيل";
}
<div class="page-heading"><div><h1>تفاصيل التسجيل</h1><p>مراجعة بيانات التسجيل الإداري.</p></div><div class="d-flex gap-2"><a class="btn btn-primary" asp-action="EditEnrollment" asp-route-id="@Model.Id">تعديل</a><a class="btn btn-outline-secondary" asp-action="Enrollments">العودة</a></div></div>
<div class="surface-card p-4"><div class="row g-4"><div class="col-md-4"><span class="text-muted small">المستخدم</span><h2 class="h5 fw-bold mt-2">@Model.UserName</h2><span class="small text-muted">#@Model.UserId</span></div><div class="col-md-4"><span class="text-muted small">الكورس</span><h2 class="h5 fw-bold mt-2">@Model.CourseTitle</h2><span class="small text-muted">#@Model.CourseId</span></div><div class="col-md-4"><span class="text-muted small">تاريخ التسجيل</span><h2 class="h5 fw-bold mt-2">@Model.EnrolledDate.ToString("yyyy/MM/dd HH:mm")</h2></div></div><hr class="my-4" /><form asp-action="DeleteEnrollment" asp-route-id="@Model.Id" method="post"><button class="btn btn-outline-danger" type="submit" data-confirm="هل تريد حذف هذا التسجيل؟"><i class="bi bi-trash3 ms-2"></i>حذف التسجيل</button></form></div>
