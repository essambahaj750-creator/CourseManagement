@model IEnumerable<UserResponseDto>

@{
    ViewData["Title"] = "إدارة المستخدمين";
    var users = Model.ToList();
    var admins = users.Count(x => x.Role == "Admin");
    var instructors = users.Count(x => x.Role == "Instructor");
}

<div class="hf-page">
    <div class="breadcrumbs"><a asp-controller="Home" asp-action="Index">الرئيسية</a><i class="bi bi-chevron-left mx-2"></i>الإدارة<i class="bi bi-chevron-left mx-2"></i>المستخدمون</div>
    <div class="page-heading">
        <div><span class="hf-eyebrow">التحكم في الوصول</span><h1 class="mt-2">إدارة المستخدمين</h1><p class="hf-subtitle">راجع الحسابات، حدّد الأدوار، وحافظ على تنظيم صلاحيات المنصة.</p></div>
        <div class="d-flex gap-2 flex-wrap"><a class="btn btn-primary" asp-action="CreateUser"><i class="bi bi-person-plus ms-2"></i>إضافة مستخدم</a><a class="btn btn-outline-primary" asp-action="Enrollments">كل التسجيلات</a></div>
    </div>

    <div class="stats-grid mb-4">
        <div class="stat-card hf-stat-card"><div><div class="label">إجمالي الحسابات</div><div class="value">@users.Count</div><div class="stat-context"><i class="bi bi-people"></i>سجلات المستخدمين</div></div><span class="stat-icon"><i class="bi bi-people"></i></span></div>
        <div class="stat-card hf-stat-card"><div><div class="label">المدربون</div><div class="value">@instructors</div><div class="stat-context"><i class="bi bi-easel2"></i>إدارة المحتوى</div></div><span class="stat-icon"><i class="bi bi-easel2"></i></span></div>
        <div class="stat-card hf-stat-card"><div><div class="label">المديرون</div><div class="value">@admins</div><div class="stat-context"><i class="bi bi-shield-check"></i>صلاحيات عليا</div></div><span class="stat-icon"><i class="bi bi-shield-lock"></i></span></div>
    </div>

    <section class="surface-card hf-panel hf-table-shell">
        <div class="hf-panel-header"><div><span class="hf-eyebrow">دليل الحسابات</span><h2>المستخدمون</h2><p>تغييرات الأدوار تُحفظ من خلال نافذة آمنة ومباشرة.</p></div><span class="hf-panel-icon"><i class="bi bi-people-fill"></i></span></div>
        <div class="table-responsive">
            <table class="table align-middle" data-datatable>
                <thead><tr><th>المستخدم</th><th>البريد الإلكتروني</th><th>الدور</th><th>الإجراءات</th></tr></thead>
                <tbody>
                @foreach (var user in users)
                {
                    var initial = string.IsNullOrWhiteSpace(user.FullName) ? "؟" : user.FullName[..1].ToUpperInvariant();
                    var roleClass = user.Role == "Admin" ? "badge-danger-soft" : user.Role == "Instructor" ? "badge-success-soft" : "badge-soft";
                    <tr>
                        <td><div class="d-flex align-items-center gap-2"><span class="avatar">@initial</span><div><strong>@user.FullName</strong><div class="small text-muted">معرّف الحساب #@user.Id</div></div></div></td>
                        <td>@user.Email</td>
                        <td><span class="badge @roleClass rounded-pill px-3 py-2">@user.Role</span></td>
                        <td><div class="action-group"><a class="btn btn-sm btn-outline-primary" asp-action="UserDetails" asp-route-id="@user.Id"><i class="bi bi-eye ms-1"></i>تفاصيل</a><a class="btn btn-sm btn-light" asp-action="EditUser" asp-route-id="@user.Id"><i class="bi bi-pencil ms-1"></i>تعديل</a><button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#roleModal-@user.Id"><i class="bi bi-person-gear ms-1"></i>الدور</button><form asp-action="DeleteUser" asp-route-id="@user.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-danger" type="submit" data-confirm="سيتم حذف المستخدم @user.FullName. هل تريد المتابعة؟"><i class="bi bi-trash ms-1"></i>حذف</button></form></div></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
</div>

@foreach (var user in users)
{
    var initial = string.IsNullOrWhiteSpace(user.FullName) ? "؟" : user.FullName[..1].ToUpperInvariant();
    var studentSelected = user.Role == "Student" ? "selected" : null;
    var instructorSelected = user.Role == "Instructor" ? "selected" : null;
    var adminSelected = user.Role == "Admin" ? "selected" : null;
    <div class="modal fade" id="roleModal-@user.Id" tabindex="-1" aria-labelledby="roleModalLabel-@user.Id" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content hf-modal">
                <div class="modal-header"><div><span class="hf-eyebrow">إجراء إداري</span><h5 class="modal-title mt-1" id="roleModalLabel-@user.Id">تغيير دور المستخدم</h5></div><button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="إغلاق"></button></div>
                <form asp-action="ChangeRole" method="post">
                    <div class="modal-body">
                        <div class="user-summary mb-4"><span class="avatar">@initial</span><div><strong>@user.FullName</strong><div class="small text-muted">@user.Email</div></div></div>
                        <input type="hidden" name="UserId" value="@user.Id" />
                        <label class="form-label" for="role-@user.Id">الدور الجديد</label>
                        <select class="form-select" name="Role" id="role-@user.Id">
                            <option value="Student" selected="@studentSelected">طالب (Student)</option>
                            <option value="Instructor" selected="@instructorSelected">مدرب (Instructor)</option>
                            <option value="Admin" selected="@adminSelected">مدير (Admin)</option>
                        </select>
                        <div class="input-hint mt-2"><i class="bi bi-info-circle ms-1"></i>سيؤثر التغيير على المسارات المتاحة مباشرة.</div>
                    </div>
                    <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">إلغاء</button><button class="btn btn-primary" type="submit"><i class="bi bi-check2 ms-1"></i>حفظ الدور</button></div>
                </form>
            </div>
        </div>
    </div>
}
