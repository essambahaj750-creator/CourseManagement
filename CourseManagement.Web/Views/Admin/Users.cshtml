@model IEnumerable<UserResponseDto>
@{
    ViewData["Title"] = "إدارة المستخدمين";
    var users = Model.ToList();
    var admins = users.Count(x => x.Role == "Admin");
    var instructors = users.Count(x => x.Role == "Instructor");
}

<div class="breadcrumbs"><a asp-controller="Home" asp-action="Index">الرئيسية</a><i class="bi bi-chevron-left mx-2"></i>الإدارة<i class="bi bi-chevron-left mx-2"></i>المستخدمون</div>
<div class="page-heading"><div><div class="section-kicker">التحكم في الوصول</div><h1>إدارة المستخدمين</h1><p>راجع الحسابات، حدّد الأدوار، وحافظ على تنظيم صلاحيات المنصة.</p></div><div class="d-flex gap-2"><a class="btn btn-primary" asp-action="CreateUser"><i class="bi bi-person-plus ms-2"></i>إضافة مستخدم</a><a class="btn btn-outline-primary" asp-action="Enrollments">كل التسجيلات</a></div></div>

<div class="stats-grid mb-4" style="grid-template-columns:repeat(3,1fr)">
    <div class="stat-card"><div><div class="label">إجمالي الحسابات</div><div class="value">@users.Count</div><div class="trend"><i class="bi bi-people ms-1"></i>سجلات المستخدمين</div></div><span class="stat-icon"><i class="bi bi-people"></i></span></div>
    <div class="stat-card"><div><div class="label">المدربون</div><div class="value">@instructors</div><div class="trend"><i class="bi bi-easel2 ms-1"></i>إدارة المحتوى</div></div><span class="stat-icon"><i class="bi bi-easel2"></i></span></div>
    <div class="stat-card"><div><div class="label">المديرون</div><div class="value">@admins</div><div class="trend"><i class="bi bi-shield-check ms-1"></i>صلاحيات عليا</div></div><span class="stat-icon"><i class="bi bi-shield-lock"></i></span></div>
</div>

<div class="surface-card table-card datatable-wrap">
    <div class="card-header-soft d-flex align-items-center justify-content-between gap-2"><div><h2 class="section-title mb-0">دليل المستخدمين</h2><span class="text-muted small">تغييرات الأدوار تُحفظ من خلال نافذة آمنة.</span></div><span class="badge badge-soft rounded-pill px-3 py-2"><i class="bi bi-database-check ms-1"></i>بيانات مباشرة</span></div>
    <div class="table-responsive"><table class="table" data-datatable><thead><tr><th>المستخدم</th><th>البريد الإلكتروني</th><th>الدور</th><th>الإجراءات</th></tr></thead><tbody>
    @foreach (var user in users)
    {
        var initial = string.IsNullOrWhiteSpace(user.FullName) ? "؟" : user.FullName[..1].ToUpperInvariant();
        var roleClass = user.Role == "Admin" ? "badge-danger-soft" : user.Role == "Instructor" ? "badge-success-soft" : "badge-soft";
        <tr><td><div class="d-flex align-items-center gap-2"><span class="avatar">@initial</span><div><strong>@user.FullName</strong><div class="small text-muted">معرّف الحساب #@user.Id</div></div></div></td><td>@user.Email</td><td><span class="badge @roleClass rounded-pill px-3 py-2">@user.Role</span></td><td><div class="action-group"><a class="btn btn-sm btn-outline-primary" asp-action="UserDetails" asp-route-id="@user.Id"><i class="bi bi-eye ms-1"></i>تفاصيل</a><a class="btn btn-sm btn-light" asp-action="EditUser" asp-route-id="@user.Id"><i class="bi bi-pencil ms-1"></i>تعديل</a><button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#roleModal-@user.Id"><i class="bi bi-person-gear ms-1"></i>الدور</button><form asp-action="DeleteUser" asp-route-id="@user.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-danger" type="submit" data-confirm="سيتم حذف المستخدم @user.FullName. هل تريد المتابعة؟"><i class="bi bi-trash ms-1"></i>حذف</button></form></div></td></tr>
    }
    </tbody></table></div>
</div>

@foreach (var user in users)
{
    <div class="modal fade" id="roleModal-@user.Id" tabindex="-1" aria-labelledby="roleModalLabel-@user.Id" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><div><div class="section-kicker">إجراء إداري</div><h5 class="modal-title" id="roleModalLabel-@user.Id">تغيير دور المستخدم</h5></div><button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="إغلاق"></button></div><form asp-action="ChangeRole" method="post"><div class="modal-body"><div class="d-flex align-items-center gap-3 p-3 rounded-3 bg-light mb-3"><span class="avatar">@user.FullName[..1].ToUpperInvariant()</span><div><strong>@user.FullName</strong><div class="small text-muted">@user.Email</div></div></div><input type="hidden" name="UserId" value="@user.Id" /><label class="form-label" for="role-@user.Id">الدور الجديد</label><select class="form-select" name="Role" id="role-@user.Id"><option value="Student" selected="@(user.Role == "Student" ? "selected" : null)">طالب (Student)</option><option value="Instructor" selected="@(user.Role == "Instructor" ? "selected" : null)">مدرب (Instructor)</option><option value="Admin" selected="@(user.Role == "Admin" ? "selected" : null)">مدير (Admin)</option></select><div class="input-hint">اختر الدور وفق مسؤوليات الحساب. سيؤثر التغيير على المسارات المتاحة مباشرة.</div></div><div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">إلغاء</button><button class="btn btn-primary" type="submit"><i class="bi bi-check2 ms-1"></i>حفظ الدور</button></div></form></div></div></div>
}
