@model RegisterViewModel
@{
    ViewData["Title"] = "إضافة مستخدم";
}

<div class="hf-page">
    <div class="breadcrumbs"><a asp-controller="Home" asp-action="Index">الرئيسية</a><i class="bi bi-chevron-left mx-2"></i><a asp-action="Users">إدارة المستخدمين</a><i class="bi bi-chevron-left mx-2"></i>إضافة مستخدم</div>
    <div class="page-heading">
        <div><span class="hf-eyebrow">إدارة الوصول</span><h1 class="mt-2">إضافة مستخدم جديد</h1><p class="hf-subtitle">أنشئ حسابًا للمتعلم أو عضو فريق المنصة.</p></div>
        <a class="btn btn-light" asp-action="Users"><i class="bi bi-arrow-right ms-2"></i>العودة للمستخدمين</a>
    </div>

    <div class="hf-form-grid">
        <section class="surface-card hf-form-shell">
            <div class="hf-form-header"><span class="table-icon"><i class="bi bi-person-plus"></i></span><div><span class="hf-eyebrow">بيانات الحساب</span><h2>معلومات المستخدم</h2><p>أدخل بيانات صحيحة حتى يتمكن المستخدم من تسجيل الدخول بأمان.</p></div></div>
            <form asp-action="CreateUser" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-4"></div>
                <div class="form-section">
                    <div class="mb-3"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" autocomplete="name" placeholder="مثال: أحمد محمد" /><span asp-validation-for="FullName" class="text-danger small"></span></div>
                    <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email" placeholder="name@example.com" dir="ltr" /><span asp-validation-for="Email" class="text-danger small"></span></div>
                    <div class="row g-3">
                        <div class="col-md-6"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password" class="text-danger small"></span></div>
                        <div class="col-md-6"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger small"></span></div>
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-2 justify-content-end"><a class="btn btn-light" asp-action="Users">إلغاء</a><button class="btn btn-primary" type="submit"><i class="bi bi-person-check ms-2"></i>إنشاء الحساب</button></div>
            </form>
        </section>
        <aside class="hf-form-aside security-card">
            <div class="security-card-icon"><i class="bi bi-shield-lock"></i></div><span class="hf-eyebrow text-white-50 mt-4">ملاحظة أمنية</span><h2 class="h5 mt-2">حافظ على بيانات الدخول خاصة</h2><p class="small text-white-50 lh-lg">سيبدأ الحساب بالصلاحية الافتراضية الآمنة، ويمكن تعديل الدور من صفحة إدارة المستخدمين عند الحاجة.</p>
            <div class="security-list"><span><i class="bi bi-check-circle-fill"></i>كلمة مرور قوية وفريدة</span><span><i class="bi bi-check-circle-fill"></i>الجلسات محمية بـCookie</span><span><i class="bi bi-check-circle-fill"></i>إمكانية إبطال الجلسة</span></div>
        </aside>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
