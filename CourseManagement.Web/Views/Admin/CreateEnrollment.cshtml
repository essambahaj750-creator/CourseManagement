@model EnrollmentCreateViewModel
@{
    ViewData["Title"] = "إضافة تسجيل";
}
<div class="page-heading"><div><h1>إضافة تسجيل</h1><p>سجّل مستخدمًا في كورس من لوحة الإدارة.</p></div><a class="btn btn-outline-secondary" asp-action="Enrollments">إلغاء</a></div>
<div class="surface-card form-card">
    <form asp-action="CreateEnrollment" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
        <div class="mb-3"><label asp-for="UserId" class="form-label"></label><select asp-for="UserId" class="form-select"><option value="">اختر المستخدم</option>@foreach (var user in Model.Users) { <option value="@user.Id">@user.FullName — @user.Email</option> }</select><span asp-validation-for="UserId" class="text-danger small"></span></div>
        <div class="mb-4"><label asp-for="CourseId" class="form-label"></label><select asp-for="CourseId" class="form-select"><option value="">اختر الكورس</option>@foreach (var course in Model.Courses) { <option value="@course.Id">@course.Title — @course.InstructorName</option> }</select><span asp-validation-for="CourseId" class="text-danger small"></span></div>
        <button class="btn btn-primary" type="submit"><i class="bi bi-journal-plus ms-2"></i>إنشاء التسجيل</button>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
