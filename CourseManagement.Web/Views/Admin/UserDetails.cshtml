@model UserResponseDto
@{
    ViewData["Title"] = "تفاصيل المستخدم";
}
<div class="page-heading"><div><h1>تفاصيل المستخدم</h1><p>مراجعة بيانات الحساب.</p></div><div class="d-flex gap-2"><a class="btn btn-primary" asp-action="EditUser" asp-route-id="@Model.Id">تعديل</a><a class="btn btn-outline-secondary" asp-action="Users">العودة</a></div></div>
<div class="surface-card p-4"><div class="row g-4 align-items-center"><div class="col-auto"><span class="avatar" style="width:72px;height:72px;font-size:1.6rem;">@Model.FullName[..1].ToUpperInvariant()</span></div><div class="col"><h2 class="h4 fw-bold mb-2">@Model.FullName</h2><p class="text-muted mb-2">@Model.Email</p><span class="badge badge-soft rounded-pill px-3 py-2">@Model.Role</span></div><div class="col-md-3"><div class="text-muted small">معرف المستخدم</div><div class="fw-bold">#@Model.Id</div></div></div></div>
