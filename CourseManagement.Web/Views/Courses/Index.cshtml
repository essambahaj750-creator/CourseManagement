@model IEnumerable<CourseResponseDto>

@{
    ViewData["Title"] = "الكورسات";
    var courses = Model.ToList();
    var searchTerm = ViewData["SearchTerm"] as string;
    var canManage = User.IsInRole("Instructor") || User.IsInRole("Admin");
}

<div class="hf-page">
    <div class="breadcrumbs"><a asp-controller="Home" asp-action="Index">الرئيسية</a><i class="bi bi-chevron-left mx-2"></i>استكشاف الكورسات</div>
    <div class="page-heading">
        <div><span class="hf-eyebrow">مكتبة التعلم</span><h1 class="mt-2">استكشف الكورسات</h1><p class="hf-subtitle">محتوى عملي مصمم ليأخذ مهاراتك خطوة بعد خطوة.</p></div>
        @if (canManage)
        {
            <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg ms-2"></i>إضافة كورس</a>
        }
    </div>

    <div class="hf-toolbar mb-4">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-lg-8"><label class="visually-hidden" for="courseSearch">بحث في الكورسات</label><div class="position-relative"><i class="bi bi-search position-absolute top-50 translate-middle-y me-3 text-muted"></i><input id="courseSearch" class="form-control pe-5" name="q" value="@searchTerm" type="search" placeholder="ابحث بالعنوان أو الوصف أو اسم المدرب..." autocomplete="off" /></div></div>
            <div class="col-sm-6 col-lg-2"><button class="btn btn-primary w-100" type="submit"><i class="bi bi-search ms-1"></i> بحث</button></div>
            @if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                <div class="col-sm-6 col-lg-2"><a class="btn btn-light w-100" asp-action="Index"><i class="bi bi-x-lg ms-1"></i> مسح</a></div>
            }
        </form>
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3 pt-3 border-top">
            <span class="hf-muted-label"><i class="bi bi-shield-check ms-1 text-success"></i>نتائج موثوقة ومحدثة</span>
            <div class="d-flex align-items-center gap-2"><span class="small text-muted">طريقة العرض</span><div class="view-switch" aria-label="طريقة عرض الكورسات"><button class="btn active" type="button" title="عرض الشبكة"><i class="bi bi-grid-3x3-gap-fill"></i></button><button class="btn" type="button" title="عرض القائمة"><i class="bi bi-list-ul"></i></button></div></div>
        </div>
    </div>

    @if (courses.Any())
    {
        <div class="d-flex align-items-end justify-content-between gap-2 mb-3"><div><h2 class="section-title mb-1">المحتوى المتاح</h2><span class="text-muted small">@courses.Count كورس @(string.IsNullOrWhiteSpace(searchTerm) ? "متاح للتعلم" : $"مطابق لعبارة «{searchTerm}»")</span></div><span class="badge badge-soft rounded-pill px-3 py-2"><i class="bi bi-stars ms-1"></i>اختيارات عملية</span></div>
        <div class="row g-4 mb-5 course-grid">
            @foreach (var course in courses)
            {
                var excerpt = string.IsNullOrWhiteSpace(course.Description) ? "مسار عملي لتطوير مهاراتك." : (course.Description.Length > 105 ? course.Description[..105] + "..." : course.Description);
                var instructorInitial = string.IsNullOrWhiteSpace(course.InstructorName) ? "م" : course.InstructorName[..1].ToUpperInvariant();
                <div class="col-md-6 col-xl-4">
                    <article class="course-card">
                        <div class="course-cover">
                            @if (!string.IsNullOrWhiteSpace(course.ImageUrl))
                            {
                                <img class="course-cover-image" src="@course.ImageUrl" alt="غلاف @course.Title" loading="lazy" />
                            }
                            <div class="course-cover-top"><span class="badge bg-light text-primary position-relative">متاح الآن</span><span class="small text-white-50 position-relative"><i class="bi bi-play-circle ms-1"></i>تعلم عملي</span></div>
                            <span class="course-cover-icon"><i class="bi bi-layers-fill"></i></span>
                        </div>
                        <div class="course-body">
                            <h3 class="mb-2">@course.Title</h3><p class="course-description mb-3">@excerpt</p>
                            <div class="course-footer-meta"><span class="course-author"><span class="avatar">@instructorInitial</span><span class="text-truncate">@course.InstructorName</span></span><span class="price-stack"><small>قيمة الكورس</small><span class="price">@course.Price.ToString("N2")</span></span></div>
                            <a class="btn btn-primary w-100 mt-3" asp-action="Details" asp-route-id="@course.Id">استكشف الكورس <i class="bi bi-arrow-left me-1"></i></a>
                        </div>
                    </article>
                </div>
            }
        </div>

        <div class="page-heading mb-3"><div><span class="hf-eyebrow">إدارة البيانات</span><h2 class="section-title mt-2 mb-0">سجل الكورسات</h2><p class="hf-subtitle">جدول قابل للبحث والفرز لمراجعة البيانات بسرعة.</p></div></div>
        <div class="hf-table-shell datatable-wrap mb-4">
            <div class="table-responsive">
                <table class="table" data-datatable>
                    <thead><tr><th>الكورس</th><th>المدرب</th><th>السعر</th><th>الإجراءات</th></tr></thead>
                    <tbody>
                    @foreach (var course in courses)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    @if (!string.IsNullOrWhiteSpace(course.ImageUrl))
                                    {
                                        <img class="table-thumb" src="@course.ImageUrl" alt="غلاف @course.Title" loading="lazy" />
                                    }
                                    else
                                    {
                                        <span class="table-thumb bg-light"><i class="bi bi-image text-muted"></i></span>
                                    }
                                    <div><strong>@course.Title</strong><div class="small text-muted">#@course.Id</div></div>
                                </div>
                            </td>
                            <td>@course.InstructorName</td><td><span class="price">@course.Price.ToString("N2")</span></td>
                            <td>
                                <div class="action-group">
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@course.Id"><i class="bi bi-eye ms-1"></i>تفاصيل</a>
                                    @if (canManage && (User.IsInRole("Admin") || course.InstructorId.ToString() == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value))
                                    {
                                        <a class="btn btn-sm btn-light" asp-action="Edit" asp-route-id="@course.Id"><i class="bi bi-pencil ms-1"></i>تعديل</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="surface-card hf-empty empty-state py-5"><div class="empty-orb"><i class="bi bi-search"></i></div><h3 class="mt-3">لم نجد كورسات مطابقة</h3><p>جرّب عبارة بحث مختلفة أو عد إلى القائمة الكاملة.</p><a class="btn btn-primary" asp-action="Index"><i class="bi bi-arrow-repeat ms-1"></i>عرض كل الكورسات</a></div>
    }
</div>
