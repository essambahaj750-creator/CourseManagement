@model CourseDetailsViewModel
@using System.Security.Claims
@using CourseManagement.Domain.Enums
@{
    ViewData["Title"] = Model.Course.Title;
    var course = Model.Course;
    var isOwner = User.IsInRole("Admin") || (User.IsInRole("Instructor") && int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var currentId) && currentId == course.InstructorId);
    var canSeeAssets = Model.CanAccessAssets;
    string FormatSize(long bytes) => bytes < 1024 * 1024 ? $"{Math.Max(1, bytes / 1024d):N0} KB" : $"{bytes / (1024d * 1024d):N1} MB";
}

<div class="breadcrumbs"><a asp-controller="Home" asp-action="Index">الرئيسية</a><i class="bi bi-chevron-left mx-2"></i><a asp-action="Index">الكورسات</a><i class="bi bi-chevron-left mx-2"></i>التفاصيل</div>
<div class="d-flex justify-content-between align-items-center gap-2 mb-3 flex-wrap">
    <a class="text-decoration-none text-muted" asp-action="Index"><i class="bi bi-arrow-right ms-2"></i>العودة للكورسات</a>
    @if (isOwner)
    {
        <div class="d-flex gap-2">
            <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@course.Id"><i class="bi bi-pencil ms-1"></i>تعديل</a>
            <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@course.Id"><i class="bi bi-trash ms-1"></i>حذف</a>
        </div>
    }
</div>

<section class="detail-cover mb-4">
    @if (!string.IsNullOrWhiteSpace(course.ImageUrl))
    {
        <img class="detail-cover-image" src="@course.ImageUrl" alt="غلاف @course.Title" loading="eager" />
    }
    <div class="detail-cover-overlay"></div><div class="detail-cover-content"><span class="badge bg-light text-primary mb-3"><i class="bi bi-stars ms-1"></i>كورس تعليمي</span><h1 class="display-6 fw-bold">@course.Title</h1><p class="mb-0 opacity-75"><i class="bi bi-person ms-1"></i>بواسطة @course.InstructorName</p></div>
</section>

<div class="row g-4 align-items-start">
    <div class="col-lg-8">
        <div class="surface-card p-4 p-lg-5">
            <div class="section-kicker">نظرة عامة</div><h2 class="h3 fw-bold mb-3">عن الكورس</h2><p class="text-muted lh-lg mb-4">@course.Description</p>
            <div class="row g-3 border-top pt-4"><div class="col-sm-4"><div class="detail-fact"><span><i class="bi bi-person"></i></span><div><small>المدرب</small><strong>@course.InstructorName</strong></div></div></div><div class="col-sm-4"><div class="detail-fact"><span><i class="bi bi-hash"></i></span><div><small>المعرّف</small><strong>#@course.Id</strong></div></div></div><div class="col-sm-4"><div class="detail-fact"><span><i class="bi bi-patch-check"></i></span><div><small>الحالة</small><strong>متاح للتسجيل</strong></div></div></div></div>
        </div>

        @if (canSeeAssets)
        {
            <section class="surface-card p-4 p-lg-5 mt-4">
                <div class="d-flex justify-content-between align-items-center gap-3 mb-3 flex-wrap"><div><div class="section-kicker">محتوى الكورس</div><h2 class="h3 fw-bold mb-1">الفيديوهات والمرفقات</h2><p class="text-muted small mb-0">الملفات متاحة للمستخدم المصرح له فقط.</p></div><span class="badge rounded-pill text-bg-light">@course.Assets.Count ملف</span></div>
                @if (course.Assets.Count == 0)
                {
                    <div class="empty-state py-4"><i class="bi bi-folder2-open"></i><p class="mb-0">لم تتم إضافة ملفات لهذا الكورس بعد.</p></div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var asset in course.Assets)
                        {
                            var assetIcon = asset.Type == CourseAssetType.Video ? "bi-play-btn-fill" : "bi-file-earmark-text-fill";
                            var assetLabel = asset.Type == CourseAssetType.Video ? "فيديو" : "مرفق";
                            <div class="list-group-item px-0 py-3 d-flex align-items-center gap-3 flex-wrap">
                                <div class="asset-icon rounded-3 bg-primary-subtle text-primary d-flex align-items-center justify-content-center"><i class="bi @assetIcon"></i></div>
                                <div class="flex-grow-1 min-width-0"><strong class="d-block text-truncate">@asset.OriginalFileName</strong><small class="text-muted">@assetLabel · @FormatSize(asset.SizeBytes)</small></div>
                                <div class="d-flex gap-2">
                                    <a class="btn btn-sm btn-outline-primary" asp-action="DownloadAsset" asp-route-id="@course.Id" asp-route-assetId="@asset.Id"><i class="bi bi-download ms-1"></i>تنزيل</a>
                                    @if (isOwner)
                                    {
                                        <form asp-action="DeleteAsset" asp-route-id="@course.Id" asp-route-assetId="@asset.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-sm btn-outline-danger" type="submit" onclick="return confirm('هل تريد حذف هذا الملف؟');"><i class="bi bi-trash"></i></button>
                                        </form>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>
        }
        else if (User.Identity?.IsAuthenticated != true)
        {
            <div class="alert alert-info mt-4"><i class="bi bi-lock ms-1"></i>سجّل الدخول أو سجّل في الكورس للوصول إلى الفيديوهات والمرفقات.</div>
        }

        @if (isOwner)
        {
            <section class="surface-card p-4 p-lg-5 mt-4">
                <div class="section-kicker">إدارة المحتوى</div><h2 class="h4 fw-bold mb-2">رفع فيديو أو ملف للكورس</h2><p class="text-muted small">الفيديو حتى 512MB، والمرفقات حتى 50MB. الامتدادات المسموحة محددة لحماية المنصة.</p>
                <form asp-action="UploadAsset" asp-route-id="@course.Id" method="post" enctype="multipart/form-data" class="row g-3">
                    @Html.AntiForgeryToken()
                    <div class="col-md-7"><label for="file" class="form-label">الملف</label><input id="file" name="file" class="form-control" type="file" accept="video/mp4,video/webm,video/quicktime,.pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.zip,.txt" /></div>
                    <div class="col-md-5"><label for="type" class="form-label">نوع الملف</label><select id="type" name="type" class="form-select"><option value="1">فيديو تعليمي</option><option value="2">ملف مرفق</option></select></div>
                    <div class="col-12"><button class="btn btn-primary" type="submit"><i class="bi bi-cloud-arrow-up ms-2"></i>رفع وربط الملف</button></div>
                </form>
            </section>
        }
    </div>
    <div class="col-lg-4">
        <div class="surface-card p-4 sticky-lg-top" style="top:1.25rem">
            <div class="text-muted small">استثمر في تعلمك</div><div class="display-6 fw-bold text-primary my-2">@course.Price.ToString("N2") <small class="fs-6">ر.س</small></div><p class="text-muted small">احصل على وصول منظم إلى هذا المسار التعليمي.</p>
            @if (User.Identity?.IsAuthenticated == true && !isOwner)
            {
                <form asp-controller="Enrollments" asp-action="Enroll" asp-route-courseId="@course.Id" method="post"><button class="btn btn-primary w-100 mt-3" type="submit"><i class="bi bi-journal-plus ms-2"></i>التسجيل في الكورس</button></form>
            }
            else if (User.Identity?.IsAuthenticated != true)
            {
                <a class="btn btn-primary w-100 mt-3" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path"><i class="bi bi-box-arrow-in-left ms-2"></i>سجل الدخول للتسجيل</a>
            }
            else
            {
                <div class="alert alert-info small mt-3 mb-0"><i class="bi bi-info-circle ms-1"></i>أنت مالك هذا الكورس.</div>
            }
            <div class="detail-checklist mt-4"><span><i class="bi bi-check-circle-fill"></i>وصف واضح للمحتوى</span><span><i class="bi bi-check-circle-fill"></i>مدرب محدد</span><span><i class="bi bi-check-circle-fill"></i>ملفات محمية</span></div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
