@model CourseFormViewModel
@{
    ViewData["Title"] = "تعديل الكورس";
}

<div class="breadcrumbs"><a asp-controller="Home" asp-action="Index">الرئيسية</a><i class="bi bi-chevron-left mx-2"></i><a asp-action="Index">الكورسات</a><i class="bi bi-chevron-left mx-2"></i>تعديل</div>
<div class="page-heading"><div><div class="section-kicker">إدارة المحتوى</div><h1>تعديل الكورس</h1><p>حدّث معلومات الكورس ثم احفظ التغييرات بعناية.</p></div><a class="btn btn-light" asp-action="Details" asp-route-id="@Model.Id"><i class="bi bi-arrow-right ms-2"></i>العودة للتفاصيل</a></div>

<div class="hf-form-grid">
    <div class="col-lg-8"><div class="surface-card hf-form-shell form-card"><div class="card-header-soft mb-4"><h2 class="section-title mb-1">تحرير البيانات</h2><p class="text-muted small mb-0">أي تعديل سيظهر مباشرة للطلاب في صفحة الكورس.</p></div><form asp-action="Edit" asp-route-id="@Model.Id" method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div><div class="mb-3"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" autofocus /><span asp-validation-for="Title" class="text-danger small"></span></div><div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="7"></textarea><div class="input-hint"><i class="bi bi-lightbulb ms-1"></i>حافظ على الوصف مركزًا ومرتبطًا بمخرجات التعلم.</div><span asp-validation-for="Description" class="text-danger small"></span></div><div class="row g-3"><div class="col-md-8"><label asp-for="ImageUrl" class="form-label"></label><input asp-for="ImageUrl" class="form-control" placeholder="https://example.com/course-cover.jpg" /><span asp-validation-for="ImageUrl" class="text-danger small"></span></div><div class="col-md-4"><label asp-for="Price" class="form-label"></label><div class="input-group"><span class="input-group-text">ر.س</span><input asp-for="Price" class="form-control" type="number" min="0" step="0.01" /></div><span asp-validation-for="Price" class="text-danger small"></span></div></div><div class="d-flex gap-2 mt-4"><button class="btn btn-primary" type="submit"><i class="bi bi-save ms-2"></i>حفظ التغييرات</button><a class="btn btn-light" asp-action="Details" asp-route-id="@Model.Id">إلغاء</a></div></form></div></div>
    <div class="col-lg-4"><div class="surface-card hf-form-aside p-4"><div class="section-kicker">مراجعة سريعة</div><h2 class="h5 mt-2">قبل الحفظ</h2><p class="text-muted small">تأكد من صحة الرابط والصورة والسعر، ثم افتح صفحة التفاصيل لمراجعة العرض النهائي.</p><a class="btn btn-outline-primary w-100" asp-action="Details" asp-route-id="@Model.Id"><i class="bi bi-eye ms-2"></i>معاينة الكورس</a></div></div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
