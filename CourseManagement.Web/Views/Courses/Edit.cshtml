@model CourseManagement.Web.ViewModels.CourseFormViewModel

@{
    ViewData["Title"] = "تعديل الكورس";
    var currentCoverUrl = Url.Action("Cover", "Courses", new { id = Model.Id });
}

<div class="breadcrumbs"><a asp-controller="Home" asp-action="Index">الرئيسية</a><i class="bi bi-chevron-left mx-2"></i><a asp-action="Index">الكورسات</a><i class="bi bi-chevron-left mx-2"></i>تعديل</div>
<div class="page-heading">
    <div><div class="section-kicker">إدارة المحتوى</div><h1>تعديل بيانات الكورس</h1><p>حدّث المعلومات، صحح المدرّس المسؤول، وشاهد المعاينة قبل الحفظ.</p></div>
    <a class="btn btn-light" asp-action="Details" asp-route-id="@Model.Id"><i class="bi bi-arrow-right ms-2"></i>العودة للتفاصيل</a>
</div>

<div class="hf-form-grid">
    <div class="col-lg-8">
        <div class="surface-card hf-form-shell form-card">
            <div class="card-header-soft mb-4"><h2 class="section-title mb-1">تحرير البيانات</h2><p class="text-muted small mb-0">أي تعديل سيظهر للطلاب بعد الحفظ.</p></div>
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                <input asp-for="Id" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                @if (User.IsInRole("Admin"))
                {
                    <div class="mb-3">
                        <label asp-for="InstructorId" class="form-label"></label>
                        <select asp-for="InstructorId" class="form-select">
                            <option value="">اختر المدرّس المسؤول</option>
                            @foreach (var instructor in Model.Instructors)
                            {
                                <option value="@instructor.Id">@instructor.FullName (@instructor.Role)</option>
                            }
                        </select>
                        <div class="input-hint"><i class="bi bi-arrow-left-right ms-1"></i>إذا كان الكورس القديم مسندًا إلى Administrator، اختر حساب Instructor حقيقي لتصحيح الملكية.</div>
                        <span asp-validation-for="InstructorId" class="text-danger small"></span>
                    </div>
                }

                <div class="mb-3"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" autofocus /><span asp-validation-for="Title" class="text-danger small"></span></div>
                <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="7"></textarea><div class="input-hint"><i class="bi bi-lightbulb ms-1"></i>حافظ على الوصف مركزًا ومرتبطًا بمخرجات التعلم.</div><span asp-validation-for="Description" class="text-danger small"></span></div>
                <div class="row g-3">
                    <div class="col-md-8"><label asp-for="CoverImage" class="form-label"></label><input asp-for="CoverImage" class="form-control" type="file" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" /><div class="input-hint"><i class="bi bi-image ms-1"></i>اتركه فارغًا للحفاظ على الحالية، أو اختر JPG/PNG/WebP حتى 5MB.</div><span asp-validation-for="CoverImage" class="text-danger small"></span></div>
                    <div class="col-md-4"><label asp-for="Price" class="form-label"></label><div class="input-group"><span class="input-group-text">ر.س</span><input asp-for="Price" class="form-control" type="number" min="0" step="0.01" /></div><span asp-validation-for="Price" class="text-danger small"></span></div>
                </div>
                <div class="d-flex gap-2 mt-4"><button class="btn btn-primary" type="submit"><i class="bi bi-save ms-2"></i>حفظ التغييرات</button><a class="btn btn-light" asp-action="Details" asp-route-id="@Model.Id">إلغاء</a></div>
            </form>

            @if (!string.IsNullOrWhiteSpace(Model.CurrentCoverUrl))
            {
                <form asp-action="DeleteCover" asp-route-id="@Model.Id" method="post" class="mt-3" data-confirm="هل تريد حذف غلاف الكورس الحالي؟">
                    <button class="btn btn-outline-danger" type="submit"><i class="bi bi-trash3 ms-2"></i>حذف الغلاف الحالي</button>
                </form>
            }
        </div>
    </div>

    <div class="col-lg-4">
        <div class="course-preview-card" aria-live="polite">
            <div class="course-preview-head"><div><div class="section-kicker mb-1">تجربة الطالب</div><strong>معاينة قبل الحفظ</strong></div><span class="course-preview-badge"><i class="bi bi-eye"></i> حيّة</span></div>
            <div class="course-preview-cover">
                <img id="previewImage" src="@currentCoverUrl" class="@(string.IsNullOrWhiteSpace(Model.CurrentCoverUrl) ? "d-none" : "")" alt="معاينة صورة الغلاف" onerror="this.classList.add('d-none'); document.getElementById('previewPlaceholder').classList.remove('d-none');" />
                <div id="previewPlaceholder" class="course-preview-placeholder @(string.IsNullOrWhiteSpace(Model.CurrentCoverUrl) ? "" : "d-none")"><i class="bi bi-image"></i></div>
                <div class="course-preview-cover-label"><strong id="previewTitle">@Model.Title</strong><span id="previewPrice">@(Model.Price > 0 ? $"{Model.Price:0.00} ر.س" : "مجاني")</span></div>
            </div>
            <div class="course-preview-body">
                <h3 id="previewTitleText">@Model.Title</h3>
                <p id="previewDescription">@(string.IsNullOrWhiteSpace(Model.Description) ? "سيظهر وصف الكورس هنا أثناء الكتابة، ليعرف الطالب قيمة المحتوى قبل التسجيل." : Model.Description)</p>
                <div class="course-preview-meta"><small><i class="bi bi-person-check ms-1"></i>مسار تعليمي عملي</small><strong id="previewPriceMeta">@(Model.Price > 0 ? $"{Model.Price:0.00} ر.س" : "مجاني")</strong></div>
                <div class="course-preview-note"><i class="bi bi-info-circle ms-1"></i>فيديو المعاينة ملف مستقل قصير؛ دروس الفيديو الكاملة لا تُعرض للزائر قبل التسجيل.</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const title = document.getElementById('Title');
            const description = document.getElementById('Description');
            const price = document.getElementById('Price');
            const cover = document.getElementById('CoverImage');
            const titleOverlay = document.getElementById('previewTitle');
            const titleText = document.getElementById('previewTitleText');
            const descriptionText = document.getElementById('previewDescription');
            const priceOverlay = document.getElementById('previewPrice');
            const priceMeta = document.getElementById('previewPriceMeta');
            const image = document.getElementById('previewImage');
            const placeholder = document.getElementById('previewPlaceholder');
            const formatPrice = () => {
                const value = Number(price?.value ?? 0);
                return Number.isFinite(value) && value > 0 ? `${value.toFixed(2)} ر.س` : 'مجاني';
            };
            const sync = () => {
                const nextTitle = title?.value.trim() || 'عنوان الكورس';
                const nextDescription = description?.value.trim() || 'سيظهر وصف الكورس هنا أثناء الكتابة، ليعرف الطالب قيمة المحتوى قبل التسجيل.';
                const nextPrice = formatPrice();
                titleOverlay.textContent = nextTitle;
                titleText.textContent = nextTitle;
                descriptionText.textContent = nextDescription;
                priceOverlay.textContent = nextPrice;
                priceMeta.textContent = nextPrice;
            };
            [title, description, price].forEach((field) => field?.addEventListener('input', sync));
            cover?.addEventListener('change', () => {
                const file = cover.files?.[0];
                if (!file) return;
                const reader = new FileReader();
                reader.onload = (event) => {
                    image.src = event.target.result;
                    image.classList.remove('d-none');
                    placeholder.classList.add('d-none');
                };
                reader.readAsDataURL(file);
            });
            sync();
        })();
    </script>
}
