@model CourseFormViewModel
@{
    ViewData["Title"] = "إضافة كورس";
}

<div class="breadcrumbs"><a asp-controller="Home" asp-action="Index">الرئيسية</a><i class="bi bi-chevron-left mx-2"></i><a asp-action="Index">الكورسات</a><i class="bi bi-chevron-left mx-2"></i>إضافة</div>
<div class="page-heading"><div><div class="section-kicker">إدارة المحتوى</div><h1>إضافة كورس جديد</h1><p>أنشئ الكورس وارفع غلافه من جهازك، ثم أضف الفيديوهات والمرفقات من صفحة التفاصيل.</p></div><a class="btn btn-light" asp-action="Index"><i class="bi bi-arrow-right ms-2"></i>العودة للكورسات</a></div>

<div class="hf-form-grid">
    <div class="col-lg-8"><div class="surface-card hf-form-shell form-card"><div class="card-header-soft mb-4"><h2 class="section-title mb-1">معلومات الكورس</h2><p class="text-muted small mb-0">اكتب المعلومات الأساسية واختر صورة غلاف حقيقية من جهازك.</p></div><form asp-action="Create" method="post" enctype="multipart/form-data"><div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div><div class="mb-3"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" placeholder="مثال: أساسيات تطوير الويب" autofocus /><span asp-validation-for="Title" class="text-danger small"></span></div><div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="7" placeholder="اشرح ما الذي سيتعلمه الطالب وما الفائدة العملية..."></textarea><div class="input-hint"><i class="bi bi-lightbulb ms-1"></i>اجعل الوصف مباشرًا واذكر مخرجات التعلم المتوقعة.</div><span asp-validation-for="Description" class="text-danger small"></span></div><div class="row g-3"><div class="col-md-8"><label asp-for="CoverImage" class="form-label"></label><input asp-for="CoverImage" class="form-control" type="file" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" /><div class="input-hint"><i class="bi bi-image ms-1"></i>اختر JPG أو PNG أو WebP حتى 5MB من جهازك.</div><span asp-validation-for="CoverImage" class="text-danger small"></span></div><div class="col-md-4"><label asp-for="Price" class="form-label"></label><div class="input-group"><span class="input-group-text">ر.س</span><input asp-for="Price" class="form-control" type="number" min="0" step="0.01" placeholder="0.00" /></div><span asp-validation-for="Price" class="text-danger small"></span></div></div><div class="d-flex gap-2 mt-4"><button class="btn btn-primary" type="submit"><i class="bi bi-check2-circle ms-2"></i>حفظ الكورس</button><a class="btn btn-light" asp-action="Index">إلغاء</a></div></form></div></div>
    <div class="col-lg-4"><div class="process-card hf-form-aside"><span class="process-number">01</span><h2 class="h5 mt-3">قبل النشر</h2><p class="text-white-50">بعد حفظ الكورس يمكنك فتح التفاصيل ورفع فيديوهات الدروس وملفات PDF والمرفقات من جهازك.</p><div class="process-list"><span><i class="bi bi-check2-circle"></i>عنوان واضح</span><span><i class="bi bi-check2-circle"></i>وصف مفيد</span><span><i class="bi bi-check2-circle"></i>غلاف محلي</span><span><i class="bi bi-check2-circle"></i>سعر صحيح</span></div></div></div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
