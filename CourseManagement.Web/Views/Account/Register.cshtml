@model RegisterViewModel

@{
    ViewData["Title"] = "إنشاء حساب";
    ViewData["AuthPage"] = true;
}

<div class="auth-shell hf-auth">
    <div class="hf-auth-frame">
        <div class="row g-0">
            <div class="col-lg-6 order-lg-2">
                <section class="hf-auth-visual h-100">
                    <div class="hf-auth-visual-content d-flex flex-column h-100">
                        <a class="brand text-white text-decoration-none align-self-start" asp-controller="Home" asp-action="Index"><span class="brand-mark"><i class="bi bi-mortarboard-fill"></i></span><span><strong>منصة المعرفة</strong><small>تعلّم بوضوح</small></span></a>
                        <div class="mt-auto mb-auto">
                            <span class="hero-kicker"><i class="bi bi-rocket-takeoff"></i> خطوتك الأولى تبدأ الآن</span>
                            <h1>ابنِ عادتك التعليمية من أول يوم.</h1>
                            <p>حساب واحد يمنحك مساحة مرتبة لاكتشاف الكورسات، حفظ التسجيلات، ومتابعة ما يهمك.</p>
                            <div class="hf-auth-points"><div><i class="bi bi-check-circle-fill"></i><span>تصفح محتوى منظم وواضح</span></div><div><i class="bi bi-check-circle-fill"></i><span>احتفظ بتسجيلاتك في مكان واحد</span></div><div><i class="bi bi-check-circle-fill"></i><span>ابدأ مجانًا وبخطوات بسيطة</span></div></div>
                        </div>
                        <div class="small text-white-50"><i class="bi bi-stars ms-1"></i>كل رحلة كبيرة تبدأ بخطوة صغيرة.</div>
                    </div>
                </section>
            </div>
            <div class="col-lg-6 order-lg-1">
                <section class="hf-auth-form">
                    <div class="auth-icon"><i class="bi bi-person-plus-fill"></i></div>
                    <span class="hf-eyebrow">حساب جديد</span><h2 class="h2 fw-bold mt-3 mb-2">أنشئ حسابك</h2><p class="text-muted mb-4">ابدأ التعلم في دقائق، واحتفظ بمسارك دائمًا.</p>
                    <form asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>
                        <div class="mb-3"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" autocomplete="name" placeholder="اكتب اسمك الكامل" /><span asp-validation-for="FullName" class="text-danger small"></span></div>
                        <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email" placeholder="name@example.com" /><span asp-validation-for="Email" class="text-danger small"></span></div>
                        <div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="new-password" placeholder="12 حرفًا على الأقل" /><div class="input-hint"><i class="bi bi-shield-check ms-1"></i>استخدم مزيجًا من الحروف والأرقام والرموز.</div><span asp-validation-for="Password" class="text-danger small"></span></div>
                        <div class="mb-4"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="أعد كتابة كلمة المرور" /><span asp-validation-for="ConfirmPassword" class="text-danger small"></span></div>
                        <button class="btn btn-primary w-100" type="submit"><i class="bi bi-person-check ms-2"></i>إنشاء الحساب</button>
                    </form>
                    <p class="text-center text-muted small mt-4 mb-0">لديك حساب بالفعل؟ <a asp-action="Login" class="text-primary fw-bold text-decoration-none">سجل الدخول <i class="bi bi-arrow-left"></i></a></p>
                </section>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
