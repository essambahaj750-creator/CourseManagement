@model LoginViewModel

@{
    ViewData["Title"] = "تسجيل الدخول";
    ViewData["AuthPage"] = true;
}

<div class="auth-shell hf-auth">
    <div class="hf-auth-frame">
        <div class="row g-0">
            <div class="col-lg-6">
                <section class="hf-auth-visual h-100" aria-label="مزايا منصة المعرفة">
                    <div class="hf-auth-visual-content d-flex flex-column h-100">
                        <a class="brand text-white text-decoration-none align-self-start" asp-controller="Home" asp-action="Index">
                            <span class="brand-mark" aria-hidden="true"><i class="bi bi-mortarboard-fill"></i></span>
                            <span>
                                <strong>منصة المعرفة</strong>
                                <small>تعلّم بوضوح</small>
                            </span>
                        </a>

                        <div class="mt-auto mb-auto">
                            <span class="hero-kicker"><i class="bi bi-stars"></i> دخول آمن إلى مسارك</span>
                            <h1>المعرفة التي اخترتها بانتظارك.</h1>
                            <p>عد إلى تسجيلاتك، اكتشف محتوى جديدًا، واجعل كل جلسة تعلم أقرب إلى هدفك.</p>

                            <div class="hf-auth-points">
                                <div><i class="bi bi-check-circle-fill"></i><span>تجربة عربية مريحة على كل شاشة</span></div>
                                <div><i class="bi bi-check-circle-fill"></i><span>جلسة محمية وصلاحيات واضحة</span></div>
                                <div><i class="bi bi-check-circle-fill"></i><span>محتوى عملي قابل للاستكشاف</span></div>
                            </div>
                        </div>

                        <div class="small text-white-50">
                            <i class="bi bi-lock-fill ms-1"></i>
                            بياناتك محمية ولا نشاركها مع أي طرف.
                        </div>
                    </div>
                </section>
            </div>

            <div class="col-lg-6">
                <section class="hf-auth-form">
                    <div class="auth-icon" aria-hidden="true"><i class="bi bi-shield-lock-fill"></i></div>
                    <span class="hf-eyebrow">الدخول الآمن</span>
                    <h2>مرحبًا بعودتك</h2>
                    <p class="text-muted mb-4">سجّل دخولك لمتابعة رحلة التعلم وإدارة حسابك من مكان واحد.</p>

                    <form asp-action="Login" method="post" novalidate>
                        <input asp-for="ReturnUrl" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3" role="alert"></div>

                        <div class="hf-auth-field">
                            <div class="hf-auth-field-head">
                                <label asp-for="Email" class="form-label"></label>
                            </div>
                            <div class="hf-input">
                                <span class="hf-input-icon" aria-hidden="true"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email"
                                       class="form-control"
                                       autocomplete="email"
                                       inputmode="email"
                                       spellcheck="false"
                                       placeholder="name@example.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="hf-auth-field">
                            <div class="hf-auth-field-head">
                                <label asp-for="Password" class="form-label"></label>
                                <span class="hf-muted-label"><i class="bi bi-lock ms-1"></i>محمية</span>
                            </div>
                            <div class="hf-input hf-password">
                                <span class="hf-input-icon" aria-hidden="true"><i class="bi bi-key"></i></span>
                                <input asp-for="Password"
                                       class="form-control"
                                       autocomplete="current-password"
                                       placeholder="••••••••" />
                                <button type="button"
                                        class="hf-password-toggle"
                                        data-password-toggle
                                        aria-label="إظهار كلمة المرور"
                                        aria-pressed="false">
                                    <i class="bi bi-eye" aria-hidden="true"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="d-flex align-items-center justify-content-between gap-3 mb-4">
                            <div class="form-check mb-0">
                                <input asp-for="RememberMe" class="form-check-input" />
                                <label asp-for="RememberMe" class="form-check-label"></label>
                            </div>
                            <span class="small text-muted">اتصال آمن</span>
                        </div>

                        <button class="btn btn-primary w-100" type="submit">
                            تسجيل الدخول
                            <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>
                        </button>
                    </form>

                    <div class="hf-auth-divider"><span>أو</span></div>

                    <p class="hf-auth-create">
                        ليس لديك حساب؟
                        <a asp-action="Register" class="text-decoration-none">أنشئ حسابًا الآن <i class="bi bi-arrow-left"></i></a>
                    </p>
                </section>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
