@model LoginViewModel

@{
    ViewData["Title"] = "تسجيل الدخول";
    ViewData["AuthPage"] = true;
}

<div class="auth-shell hf-auth">
    <div class="hf-auth-frame">
        <div class="row g-0">
            <div class="col-lg-6">
                <section class="hf-auth-visual h-100">
                    <div class="hf-auth-visual-content d-flex flex-column h-100">
                        <a class="brand text-white text-decoration-none align-self-start" asp-controller="Home" asp-action="Index"><span class="brand-mark"><i class="bi bi-mortarboard-fill"></i></span><span><strong>منصة المعرفة</strong><small>تعلّم بوضوح</small></span></a>
                        <div class="mt-auto mb-auto">
                            <span class="hero-kicker"><i class="bi bi-stars"></i> دخول آمن إلى مسارك</span>
                            <h1>المعرفة التي اخترتها بانتظارك.</h1>
                            <p>عد إلى تسجيلاتك، اكتشف محتوى جديدًا، واجعل كل جلسة تعلم أقرب إلى هدفك.</p>
                            <div class="hf-auth-points"><div><i class="bi bi-check-circle-fill"></i><span>تجربة عربية مريحة على كل شاشة</span></div><div><i class="bi bi-check-circle-fill"></i><span>جلسة محمية وصلاحيات واضحة</span></div><div><i class="bi bi-check-circle-fill"></i><span>محتوى عملي قابل للاستكشاف</span></div></div>
                        </div>
                        <div class="small text-white-50"><i class="bi bi-lock-fill ms-1"></i>بياناتك محمية ولا نشاركها مع أي طرف.</div>
                    </div>
                </section>
            </div>
            <div class="col-lg-6">
                <section class="hf-auth-form">
                    <div class="auth-icon"><i class="bi bi-shield-lock-fill"></i></div>
                    <span class="hf-eyebrow">الدخول الآمن</span><h2 class="h2 fw-bold mt-3 mb-2">مرحبًا بعودتك</h2><p class="text-muted mb-4">سجّل دخولك لمتابعة رحلة التعلم.</p>
                    <form asp-action="Login" method="post">
                        <input asp-for="ReturnUrl" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>
                        <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email" placeholder="name@example.com" /><span asp-validation-for="Email" class="text-danger small"></span></div>
                        <div class="mb-3"><div class="d-flex justify-content-between align-items-center"><label asp-for="Password" class="form-label mb-0"></label><span class="hf-muted-label"><i class="bi bi-lock ms-1"></i>محمية</span></div><input asp-for="Password" class="form-control mt-2" autocomplete="current-password" placeholder="••••••••" /><span asp-validation-for="Password" class="text-danger small"></span></div>
                        <div class="form-check mb-4"><input asp-for="RememberMe" class="form-check-input" /><label asp-for="RememberMe" class="form-check-label"></label></div>
                        <button class="btn btn-primary w-100" type="submit"><i class="bi bi-box-arrow-in-left ms-2"></i>تسجيل الدخول</button>
                    </form>
                    <div class="d-flex align-items-center gap-3 text-muted small mt-4"><span class="flex-grow-1 border-top"></span><span>أو</span><span class="flex-grow-1 border-top"></span></div>
                    <p class="text-center text-muted small mt-4 mb-0">ليس لديك حساب؟ <a asp-action="Register" class="text-primary fw-bold text-decoration-none">أنشئ حسابًا الآن <i class="bi bi-arrow-left"></i></a></p>
                </section>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
