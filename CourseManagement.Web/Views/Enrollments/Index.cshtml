@model IEnumerable<EnrollmentDto>

@{
    ViewData["Title"] = "تسجيلاتي";
    var enrollments = Model.OrderByDescending(x => x.EnrolledDate).ToList();
    var latest = enrollments.FirstOrDefault();
}

<div class="hf-page">
    <div class="breadcrumbs"><a asp-controller="Home" asp-action="Index">الرئيسية</a><i class="bi bi-chevron-left mx-2"></i>تسجيلاتي</div>
    <div class="page-heading">
        <div><span class="hf-eyebrow">مساري التعليمي</span><h1 class="mt-2">تسجيلاتي</h1><p class="hf-subtitle">تابع الكورسات التي بدأت بها وواصل التقدم نحو أهدافك.</p></div>
        <a class="btn btn-primary" asp-controller="Courses" asp-action="Index"><i class="bi bi-compass ms-2"></i>اكتشف كورسات</a>
    </div>

    <div class="stats-grid mb-4">
        <div class="stat-card hf-stat-card"><div><div class="label">كورساتي</div><div class="value">@enrollments.Count</div><div class="stat-context"><i class="bi bi-journal-check"></i>تسجيلات محفوظة</div></div><span class="stat-icon"><i class="bi bi-journal-check"></i></span></div>
        <div class="stat-card hf-stat-card"><div><div class="label">آخر تسجيل</div><div class="value">@(latest is null ? "—" : latest.EnrolledDate.ToLocalTime().ToString("dd/MM"))</div><div class="stat-context"><i class="bi bi-calendar2-check"></i>تاريخ النشاط</div></div><span class="stat-icon"><i class="bi bi-calendar2-week"></i></span></div>
        <div class="stat-card hf-stat-card"><div><div class="label">الخطوة التالية</div><div class="value">تابع</div><div class="stat-context"><i class="bi bi-rocket-takeoff"></i>لا تتوقف عن التعلم</div></div><span class="stat-icon"><i class="bi bi-rocket-takeoff"></i></span></div>
    </div>

    <section class="surface-card hf-panel hf-table-shell">
        <div class="hf-panel-header">
            <div><span class="hf-eyebrow">مساراتك المحفوظة</span><h2>الكورسات المسجلة</h2><p>افتح التفاصيل أو أدر تسجيلك في أي وقت.</p></div>
            <span class="hf-panel-icon"><i class="bi bi-journal-bookmark-fill"></i></span>
        </div>
        @if (enrollments.Count == 0)
        {
            <div class="hf-empty empty-state py-5"><div class="empty-orb"><i class="bi bi-journal-x"></i></div><h3 class="mt-3">لم تسجل في أي كورس بعد</h3><p>ابدأ رحلة التعلم باختيار كورس مناسب لأهدافك.</p><a class="btn btn-primary" asp-controller="Courses" asp-action="Index">استكشاف الكورسات</a></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle" data-datatable>
                    <thead><tr><th>الكورس</th><th>تاريخ التسجيل</th><th>الحالة</th><th>الإجراء</th></tr></thead>
                    <tbody>
                    @foreach (var enrollment in enrollments)
                    {
                        <tr>
                            <td><div class="d-flex align-items-center gap-2"><span class="table-icon"><i class="bi bi-play-btn-fill"></i></span><div><a class="fw-bold text-decoration-none" asp-action="Details" asp-route-id="@enrollment.Id">@enrollment.CourseTitle</a><div class="small text-muted">كورس #@enrollment.CourseId</div></div></div></td>
                            <td>@enrollment.EnrolledDate.ToLocalTime().ToString("dd MMMM yyyy")</td>
                            <td><span class="badge badge-success-soft rounded-pill px-3 py-2"><i class="bi bi-check-circle ms-1"></i>مسجل</span></td>
                            <td><div class="action-group"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@enrollment.Id"><i class="bi bi-eye ms-1"></i>التفاصيل</a><form asp-action="Unenroll" asp-route-courseId="@enrollment.CourseId" method="post" class="d-inline"><button class="btn btn-sm btn-outline-danger" type="submit" data-confirm="هل تريد إلغاء التسجيل من كورس @enrollment.CourseTitle؟"><i class="bi bi-x-circle ms-1"></i>إلغاء</button></form></div></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
