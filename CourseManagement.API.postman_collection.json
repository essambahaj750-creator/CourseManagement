                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{adminEmail}}\",\"password\":\"{{adminPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Admin login 200\",()=>pm.response.to.have.status(200));",
                  "const j=pm.response.json();",
                  "pm.collectionVariables.set(\"adminToken\",j.token||\"\");",
                  "pm.collectionVariables.set(\"adminId\",String(j.userId||\"\"));",
                  "pm.collectionVariables.set(\"adminExpiresAtUtc\",j.expiresAtUtc||\"\");",
                  "pm.test(\"Admin login JWT returned\",()=>pm.expect(j.token).to.be.ok);",
                  "pm.test(\"admin role\",()=>pm.expect(pm.response.json().role).eql(\"Admin\"));"
                ]
