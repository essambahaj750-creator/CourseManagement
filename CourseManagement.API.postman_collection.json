        {
          "name": "Admin Reads Student Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/users/{{studentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"admin reads student 200\",()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin Promotes Student To Instructor",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/users/{{studentId}}/role",
            "body": {
              "mode": "raw",
              "raw": "{\"role\":\"Instructor\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"role updated 200\",()=>pm.response.to.have.status(200));",
                  "pm.test(\"role is Instructor\",()=>pm.expect(pm.response.json().role).eql(\"Instructor\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Student Profile After Role Change",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/users/{{studentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"updated student profile 200\",()=>pm.response.to.have.status(200));",
                  "pm.test(\"stored role is Instructor\",()=>pm.expect(pm.response.json().role).eql(\"Instructor\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "99 - Cleanup",
      "item": [
        {
          "name": "Delete Main Course",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/course/{{courseId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"main course deleted 204\",()=>pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Deleted Main Course - 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/course/{{courseId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"main course 404 after cleanup\",()=>pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
