          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"student profile is available\",()=>pm.response.to.have.status(200));",
                  "pm.test(\"profile belongs to a student\",()=>pm.expect(pm.response.json().role).eql(\"Student\"));"
                ]
              }
            }
          ]
        }
      ]
