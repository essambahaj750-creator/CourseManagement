            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/users",
            "description": "Verifies that the user list is restricted to administrators."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"student cannot list all users\",()=>pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Student Access to Admin Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/users/{{adminId}}",
            "description": "Checks that a student cannot access another user's protected profile."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"student cannot read another user profile\",()=>pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin - Get Student Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/users/{{studentId}}",
            "description": "Allows an administrator to view the generated student profile."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"admin can read the student profile\",()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin - Change Student Role",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/users/{{studentId}}/role",
            "body": {
              "mode": "raw",
              "raw": "{\"role\":\"Instructor\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Changes the generated student's role to Instructor."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"role update succeeds\",()=>pm.response.to.have.status(200));",
                  "pm.test(\"updated role is Instructor\",()=>pm.expect(pm.response.json().role).eql(\"Instructor\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify Updated Role",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/users/{{studentId}}",
            "description": "Confirms that the role update was persisted."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"updated profile is available\",()=>pm.response.to.have.status(200));",
                  "pm.test(\"role change is persisted\",()=>pm.expect(pm.response.json().role).eql(\"Instructor\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "99 - Cleanup",
      "item": [
        {
          "name": "Delete Test Course",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/course/{{courseId}}",
            "description": "Removes the main test course created by this collection."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"test course is deleted\",()=>pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify Test Course Deleted",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/course/{{courseId}}",
            "description": "Confirms cleanup by checking that the deleted course returns 404."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"deleted test course is no longer available\",()=>pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
