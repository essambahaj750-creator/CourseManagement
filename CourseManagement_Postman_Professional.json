      "name": "00 - Authentication",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Confirms that the API is running and reporting a healthy status."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"returns 200 OK\",()=>pm.response.to.have.status(200));",
                  "pm.test(\"reports a healthy status\",()=>pm.expect(pm.response.text()).to.include(\"Healthy\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Profile Without Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users/me",
            "description": "Verifies that protected profile data cannot be accessed anonymously."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"rejects requests without authentication\",()=>pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{adminEmail}}\",\"password\":\"{{adminPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Authenticates the seeded administrator and stores the JWT for later requests."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"admin can sign in\",()=>pm.response.to.have.status(200));",
                  "const j=pm.response.json();",
                  "pm.collectionVariables.set(\"adminToken\",j.token||\"\");",
                  "pm.collectionVariables.set(\"adminId\",String(j.userId||\"\"));",
                  "pm.collectionVariables.set(\"adminExpiresAtUtc\",j.expiresAtUtc||\"\");",
                  "pm.test(\"admin token is returned\",()=>pm.expect(j.token).to.be.ok);",
                  "pm.test(\"admin role is returned\",()=>pm.expect(pm.response.json().role).eql(\"Admin\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Admin Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/users/me",
            "description": "Returns the profile associated with the current admin token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"admin profile is available\",()=>pm.response.to.have.status(200));",
                  "pm.test(\"profile belongs to an admin\",()=>pm.expect(pm.response.json().role).eql(\"Admin\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register Student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\"fullName\":\"Postman Test Student\",\"email\":\"{{studentEmail}}\",\"password\":\"{{studentPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Creates a unique student account for this collection run and stores its token and id."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"studentEmail\",\"student.\"+Date.now()+\"@example.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"student registration succeeds\",()=>pm.response.to.have.status(200));",
                  "const j=pm.response.json();",
                  "pm.collectionVariables.set(\"studentToken\",j.token||\"\");",
                  "pm.collectionVariables.set(\"studentId\",String(j.userId||\"\"));",
                  "pm.collectionVariables.set(\"studentExpiresAtUtc\",j.expiresAtUtc||\"\");",
                  "pm.test(\"student token is returned\",()=>pm.expect(j.token).to.be.ok);",
                  "pm.collectionVariables.set(\"studentEmail\",pm.response.json().email||pm.collectionVariables.get(\"studentEmail\"));",
                  "pm.test(\"new public account uses the Student role\",()=>pm.expect(pm.response.json().role).eql(\"Student\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Student Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/users/me",
            "description": "Returns the profile associated with the current student token."
