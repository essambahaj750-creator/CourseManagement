{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=/var/lib/coursemanagement/coursemanagement.db"
  },
  "JwtSettings": {
    "IssueToken": true,
    "Secret": "SET_VIA_SECRET_STORE_OR_ENVIRONMENT",
    "Issuer": "CourseManagementAPI",
    "Audience": "CourseManagementClient",
    "ExpiryHours": 2
  },
  "Cors": {
    "AllowedOrigins": [
      "https://app.client-domain.com"
    ]
  },
  "Swagger": {
    "Enabled": false
  },
  "Database": {
    "ApplyMigrations": false
  },
  "SeedAdmin": {
    "Enabled": false
  },
  "FileUploads": {
    "RootPath": "/var/lib/coursemanagement/uploads",
    "MaxVideoBytes": 536870912,
    "MaxAttachmentBytes": 52428800,
    "MaxCoverImageBytes": 5242880,
    "AllowedVideoExtensions": [ ".mp4", ".webm", ".mov", ".m4v" ],
    "AllowedAttachmentExtensions": [ ".pdf", ".doc", ".docx", ".ppt", ".pptx", ".xls", ".xlsx", ".zip", ".txt" ],
    "AllowedCoverImageExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "client-domain.com;api.client-domain.com"
}
