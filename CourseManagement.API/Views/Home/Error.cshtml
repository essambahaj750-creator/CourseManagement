@model ErrorViewModel
@{
    ViewData["Title"] = "حدث خطأ";
}
<div class="auth-shell"><div class="surface-card auth-card text-center"><div class="auth-icon bg-danger"><i class="bi bi-exclamation-triangle"></i></div><h1 class="h3 fw-bold">حدث خطأ غير متوقع</h1><p class="text-muted">تعذر إكمال الطلب. حاول مرة أخرى أو عد إلى الصفحة الرئيسية.</p>@if (Model.ShowRequestId) { <p class="small text-muted">رقم الطلب: <code>@Model.RequestId</code></p> }<a class="btn btn-primary" asp-controller="Home" asp-action="Index">العودة للرئيسية</a></div></div>
