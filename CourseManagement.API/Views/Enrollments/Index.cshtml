@model IEnumerable<EnrollmentDto>
@{
    ViewData["Title"] = "تسجيلاتي";
    var enrollments = Model.OrderByDescending(x => x.EnrolledDate).ToList();
}

<div class="breadcrumbs"><a asp-controller="Home" asp-action="Index">الرئيسية</a><i class="bi bi-chevron-left mx-2"></i>تسجيلاتي</div>
<div class="page-heading"><div><div class="section-kicker">مساري التعليمي</div><h1>تسجيلاتي</h1><p>تابع الكورسات التي بدأت بها وواصل التقدم نحو أهدافك.</p></div><a class="btn btn-primary" asp-controller="Courses" asp-action="Index"><i class="bi bi-plus-lg ms-2"></i>اكتشف كورسات</a></div>

<div class="stats-grid mb-4" style="grid-template-columns:repeat(3,1fr)">
    <div class="stat-card"><div><div class="label">كورساتي</div><div class="value">@enrollments.Count</div><div class="trend"><i class="bi bi-journal-check ms-1"></i>تسجيلات محفوظة</div></div><span class="stat-icon"><i class="bi bi-journal-check"></i></span></div>
    <div class="stat-card"><div><div class="label">آخر تسجيل</div><div class="value">@(enrollments.Count > 0 ? enrollments[0].EnrolledDate.ToLocalTime().ToString("dd/MM") : "—")</div><div class="trend"><i class="bi bi-calendar2-check ms-1"></i>تاريخ النشاط</div></div><span class="stat-icon"><i class="bi bi-calendar2-week"></i></span></div>
    <div class="stat-card"><div><div class="label">الخطوة التالية</div><div class="value">تابع</div><div class="trend"><i class="bi bi-arrow-left ms-1"></i>لا تتوقف عن التعلم</div></div><span class="stat-icon"><i class="bi bi-rocket-takeoff"></i></span></div>
</div>

<div class="surface-card table-card datatable-wrap">
@if (enrollments.Count == 0)
{
    <div class="empty-state"><i class="bi bi-journal-x"></i><h3 class="mt-3">لم تسجل في أي كورس بعد</h3><p>ابدأ رحلة التعلم باختيار كورس مناسب لأهدافك.</p><a class="btn btn-primary" asp-controller="Courses" asp-action="Index">استكشاف الكورسات</a></div>
}
else
{
    <div class="card-header-soft d-flex align-items-center justify-content-between gap-2"><div><h2 class="section-title mb-0">الكورسات المسجلة</h2><span class="text-muted small">يمكنك فتح التفاصيل أو إلغاء التسجيل في أي وقت.</span></div><span class="badge badge-success-soft rounded-pill px-3 py-2"><i class="bi bi-check-circle ms-1"></i>مسار نشط</span></div>
    <div class="table-responsive"><table class="table" data-datatable><thead><tr><th>الكورس</th><th>تاريخ التسجيل</th><th>الحالة</th><th>الإجراء</th></tr></thead><tbody>
    @foreach (var enrollment in enrollments)
    {
        <tr><td><div class="d-flex align-items-center gap-2"><span class="stat-icon"><i class="bi bi-play-btn"></i></span><div><a class="fw-bold text-decoration-none" asp-action="Details" asp-route-id="@enrollment.Id">@enrollment.CourseTitle</a><div class="small text-muted">كورس #@enrollment.CourseId</div></div></div></td><td>@enrollment.EnrolledDate.ToLocalTime().ToString("dd MMMM yyyy")</td><td><span class="badge badge-success-soft rounded-pill px-3 py-2">مسجل</span></td><td><div class="action-group"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@enrollment.Id"><i class="bi bi-eye ms-1"></i>التفاصيل</a><form asp-action="Unenroll" asp-route-courseId="@enrollment.CourseId" method="post" class="d-inline"><button class="btn btn-sm btn-outline-danger" type="submit" data-confirm="هل تريد إلغاء التسجيل من كورس @enrollment.CourseTitle؟"><i class="bi bi-x-circle ms-1"></i>إلغاء</button></form></div></td></tr>
    }
    </tbody></table></div>
}
</div>
