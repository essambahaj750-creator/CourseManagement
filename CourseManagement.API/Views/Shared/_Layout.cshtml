@using CourseManagement.API.Mvc.Security
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var displayName = User.FindFirstValue(ClaimTypes.Name) ?? User.FindFirstValue(ClaimTypes.Email) ?? "زائر";
    var role = User.FindFirstValue(ClaimTypes.Role);
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - منصة المعرفة</title>
    <meta name="description" content="منصة إدارة الكورسات والتسجيلات التعليمية" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/datatables.net-dt@2.1.8/css/dataTables.dataTables.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="appbar border-bottom">
        <div class="container-fluid px-3 px-lg-4 d-flex align-items-center gap-3">
            <button class="btn icon-btn d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#sideDrawer" aria-label="فتح القائمة">
                <i class="bi bi-list fs-4"></i>
            </button>
            <a class="brand d-flex align-items-center gap-2 text-decoration-none" asp-controller="Home" asp-action="Index">
                <span class="brand-mark"><i class="bi bi-mortarboard-fill"></i></span>
                <span><strong>منصة المعرفة</strong><small>إدارة التعلم بسهولة</small></span>
            </a>
            <div class="flex-grow-1"></div>
            <a class="btn icon-btn d-none d-md-inline-flex" asp-controller="Courses" asp-action="Index" title="تصفح الكورسات"><i class="bi bi-search"></i></a>
            @if (isAuthenticated)
            {
                <div class="dropdown">
                    <button class="btn user-chip dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="avatar">@displayName[..1].ToUpperInvariant()</span>
                        <span class="d-none d-sm-inline">@displayName</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-start shadow-sm border-0">
                        <li><span class="dropdown-item-text small text-muted">الدور: @role</span></li>
                        <li><a class="dropdown-item" asp-controller="Enrollments" asp-action="Index"><i class="bi bi-journal-check ms-2"></i> تسجيلاتي</a></li>
                        <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-shield-lock ms-2"></i> تغيير كلمة المرور</a></li>
                        @if (role == "Admin")
                        {
                            <li><a class="dropdown-item" asp-controller="Admin" asp-action="Users"><i class="bi bi-people ms-2"></i> إدارة المستخدمين</a></li>
                        }
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button class="dropdown-item text-danger" type="submit"><i class="bi bi-box-arrow-right ms-2"></i> تسجيل الخروج</button>
                            </form>
                        </li>
                    </ul>
                </div>
            }
            else
            {
                <a class="btn btn-outline-primary d-none d-sm-inline-flex" asp-controller="Account" asp-action="Login">تسجيل الدخول</a>
                <a class="btn btn-primary" asp-controller="Account" asp-action="Register">إنشاء حساب</a>
            }
        </div>
    </header>

    <div class="app-shell">
        <aside class="sidebar d-none d-lg-flex flex-column">
            @await Html.PartialAsync("_Navigation", (isAuthenticated, role))
        </aside>
        <div class="offcanvas offcanvas-start sidebar-offcanvas" tabindex="-1" id="sideDrawer" aria-labelledby="sideDrawerLabel">
            <div class="offcanvas-header border-bottom">
                <h5 id="sideDrawerLabel" class="mb-0">القائمة الرئيسية</h5>
                <button type="button" class="btn-close ms-0" data-bs-dismiss="offcanvas" aria-label="إغلاق"></button>
            </div>
            <div class="offcanvas-body p-0">
                @await Html.PartialAsync("_Navigation", (isAuthenticated, role))
            </div>
        </div>

        <main class="main-content">
            <div class="container-fluid px-3 px-lg-4 py-4">
                @if (TempData["Success"] is string success)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert"><i class="bi bi-check-circle ms-2"></i>@success<button type="button" class="btn-close ms-0" data-bs-dismiss="alert"></button></div>
                }
                @if (TempData["Error"] is string error)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert"><i class="bi bi-exclamation-triangle ms-2"></i>@error<button type="button" class="btn-close ms-0" data-bs-dismiss="alert"></button></div>
                }
                @RenderBody()
            </div>
        </main>
    </div>

    <footer class="footer border-top">
        <div class="container-fluid px-3 px-lg-4 d-flex flex-column flex-md-row justify-content-between gap-2">
            <span>منصة المعرفة © @DateTime.UtcNow.Year</span>
            <span>تعلم. طبّق. تطوّر.</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/datatables.net@2.1.8/js/dataTables.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
