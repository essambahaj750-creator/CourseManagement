@model (bool IsAuthenticated, string? Role)
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(string name, string? expectedAction = null)
        => controller == name && (expectedAction is null || action == expectedAction) ? "active" : string.Empty;
}
<nav class="side-nav p-3">
    <div class="nav-section-title">مساحة العمل</div>
    <a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index"><i class="bi bi-grid-1x2-fill"></i><span>لوحة التحكم</span></a>
    <a class="nav-link @Active("Courses")" asp-controller="Courses" asp-action="Index"><i class="bi bi-collection-play-fill"></i><span>استكشاف الكورسات</span></a>
    @if (Model.IsAuthenticated)
    {
        <a class="nav-link @Active("Enrollments")" asp-controller="Enrollments" asp-action="Index"><i class="bi bi-journal-check"></i><span>تسجيلاتي</span></a>
    }
    @if (Model.Role == "Instructor" || Model.Role == "Admin")
    {
        <div class="nav-section-title mt-4">إدارة المحتوى</div>
        <a class="nav-link @Active("Courses", "Create")" asp-controller="Courses" asp-action="Create"><i class="bi bi-plus-circle-fill"></i><span>إضافة كورس</span><span class="nav-count">جديد</span></a>
    }
    @if (Model.Role == "Admin")
    {
        <div class="nav-section-title mt-4">الإدارة والرقابة</div>
        <a class="nav-link @Active("Admin", "Users")" asp-controller="Admin" asp-action="Users"><i class="bi bi-people-fill"></i><span>المستخدمون</span></a>
        <a class="nav-link @Active("Admin", "Enrollments")" asp-controller="Admin" asp-action="Enrollments"><i class="bi bi-bar-chart-fill"></i><span>كل التسجيلات</span></a>
    }
    @if (!Model.IsAuthenticated)
    {
        <div class="side-tip mt-auto"><i class="bi bi-lightbulb-fill"></i><strong>ابدأ رحلتك</strong><span>أنشئ حسابًا مجانيًا واحفظ الكورسات التي تناسب أهدافك.</span></div>
    }
    else
    {
        <div class="side-tip mt-auto"><i class="bi bi-lightbulb-fill"></i><strong>نصيحة اليوم</strong><span>خصص وقتًا يوميًا للتعلم المستمر، ولو بخطوة صغيرة.</span></div>
    }
</nav>
