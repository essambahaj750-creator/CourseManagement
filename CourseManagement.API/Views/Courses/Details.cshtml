@model CourseResponseDto
@{
    ViewData["Title"] = Model.Title;
    var isOwner = User.IsInRole("Admin") || (User.IsInRole("Instructor") && int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var currentId) && currentId == Model.InstructorId);
}
<div class="d-flex justify-content-between align-items-center mb-3"><a class="text-decoration-none text-muted" asp-action="Index"><i class="bi bi-arrow-right ms-2"></i>العودة للكورسات</a>@if (isOwner) { <div class="d-flex gap-2"><a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">تعديل</a><a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">حذف</a></div> }</div>
<section class="detail-cover mb-4">@if (!string.IsNullOrWhiteSpace(Model.ImageUrl)) { <img class="detail-cover-image" src="@Model.ImageUrl" alt="غلاف @Model.Title" /> } else { <i class="bi bi-code-slash detail-cover-icon"></i> }<div class="detail-cover-content"><span class="badge bg-light text-primary mb-3">كورس تعليمي</span><h1 class="display-6 fw-bold">@Model.Title</h1><p class="mb-0 opacity-75">بواسطة @Model.InstructorName</p></div></section>
<div class="row g-4">
    <div class="col-lg-8"><div class="surface-card p-4 h-100"><h2 class="h4 fw-bold mb-3">عن الكورس</h2><p class="text-muted lh-lg">@Model.Description</p><div class="d-flex gap-4 mt-4 text-muted small"><span><i class="bi bi-person ms-1"></i>@Model.InstructorName</span><span><i class="bi bi-hash ms-1"></i>@Model.Id</span></div></div></div>
    <div class="col-lg-4"><div class="surface-card p-4"><div class="text-muted small">سعر الكورس</div><div class="display-6 fw-bold text-primary my-2">@Model.Price.ToString("N2") <small class="fs-6">ر.س</small></div>@if (User.Identity?.IsAuthenticated == true && !isOwner) { <form asp-controller="Enrollments" asp-action="Enroll" asp-route-courseId="@Model.Id" method="post"><button class="btn btn-primary w-100 mt-3" type="submit"><i class="bi bi-journal-plus ms-2"></i>التسجيل في الكورس</button></form> } else if (User.Identity?.IsAuthenticated != true) { <a class="btn btn-primary w-100 mt-3" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">سجل الدخول للتسجيل</a> } else { <div class="alert alert-info small mt-3 mb-0">أنت مالك هذا الكورس.</div> }</div></div>
</div>
