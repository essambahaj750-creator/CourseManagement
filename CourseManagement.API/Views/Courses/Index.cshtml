@model IEnumerable<CourseResponseDto>
@{
    ViewData["Title"] = "استكشاف الكورسات";
    var courses = Model.ToList();
    var searchTerm = ViewData["SearchTerm"] as string;
    var canManage = User.IsInRole("Instructor") || User.IsInRole("Admin");
}

<div class="breadcrumbs"><a asp-controller="Home" asp-action="Index">الرئيسية</a><i class="bi bi-chevron-left mx-2"></i>استكشاف الكورسات</div>
<div class="page-heading">
    <div><div class="section-kicker">مكتبة التعلم</div><h1>استكشف الكورسات</h1><p>اختر محتوى عمليًا يطوّر مهاراتك خطوة بعد خطوة.</p></div>
    @if (canManage)
    {
        <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg ms-2"></i>إضافة كورس</a>
    }
</div>

<div class="surface-card mb-4 p-3 p-lg-4">
    <form asp-action="Index" method="get" class="row g-2 align-items-center">
        <div class="col-lg-8"><label class="visually-hidden" for="courseSearch">بحث</label><div class="position-relative"><i class="bi bi-search position-absolute top-50 translate-middle-y me-3 text-muted"></i><input id="courseSearch" class="form-control pe-5" name="q" value="@searchTerm" placeholder="ابحث بالعنوان أو الوصف أو اسم المدرب..." /></div></div>
        <div class="col-sm-6 col-lg-2"><button class="btn btn-primary w-100" type="submit">بحث</button></div>
        @if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            <div class="col-sm-6 col-lg-2"><a class="btn btn-light w-100" asp-action="Index">مسح البحث</a></div>
        }
    </form>
</div>

@if (courses.Any())
{
    <div class="d-flex align-items-center justify-content-between gap-2 mb-3"><div><h2 class="section-title mb-0">المحتوى المتاح</h2><span class="text-muted small">@courses.Count كورس @(string.IsNullOrWhiteSpace(searchTerm) ? "متاح للتعلم" : $"مطابق لعبارة «{searchTerm}»")</span></div><span class="badge badge-soft rounded-pill px-3 py-2"><i class="bi bi-grid-3x3-gap ms-1"></i>عرض مرئي</span></div>
    <div class="row g-4 mb-5">
        @foreach (var course in courses)
        {
            var excerpt = string.IsNullOrWhiteSpace(course.Description) ? "مسار عملي لتطوير مهاراتك." : (course.Description.Length > 105 ? course.Description[..105] + "..." : course.Description);
            <div class="col-md-6 col-xl-4">
                <article class="course-card">
                    <div class="course-cover">
                        @if (!string.IsNullOrWhiteSpace(course.ImageUrl)) { <img class="course-cover-image" src="@course.ImageUrl" alt="غلاف @course.Title" loading="lazy" /> }
                        <span class="badge bg-light text-primary position-relative">متاح الآن</span><i class="bi bi-layers-fill"></i>
                    </div>
                    <div class="course-body">
                        <h3 class="mb-2">@course.Title</h3>
                        <p class="mb-2">@excerpt</p>
                        <div class="course-meta"><span><i class="bi bi-person ms-1"></i>@course.InstructorName</span><span class="price">@course.Price.ToString("N2")</span></div>
                        <a class="btn btn-primary w-100 mt-3" asp-action="Details" asp-route-id="@course.Id">استكشف الكورس <i class="bi bi-arrow-left me-1"></i></a>
                    </div>
                </article>
            </div>
        }
    </div>

    <div class="page-heading mb-3"><div><div class="section-kicker">إدارة البيانات</div><h2 class="section-title mb-0">سجل الكورسات</h2><p>جدول قابل للبحث والفرز لمراجعة البيانات بسرعة.</p></div></div>
    <div class="surface-card table-card datatable-wrap">
        <div class="table-responsive">
            <table class="table" data-datatable>
                <thead><tr><th>الكورس</th><th>المدرب</th><th>السعر</th><th>الإجراءات</th></tr></thead>
                <tbody>
                @foreach (var course in courses)
                {
                    <tr>
                        <td><div class="d-flex align-items-center gap-2">@if (!string.IsNullOrWhiteSpace(course.ImageUrl)) { <img class="table-thumb" src="@course.ImageUrl" alt="غلاف @course.Title" loading="lazy" /> } else { <span class="table-thumb d-grid place-items-center bg-light"><i class="bi bi-image text-muted"></i></span> }<div><strong>@course.Title</strong><div class="small text-muted">#@course.Id</div></div></div></td>
                        <td>@course.InstructorName</td>
                        <td><span class="price">@course.Price.ToString("N2")</span></td>
                        <td><div class="action-group"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@course.Id"><i class="bi bi-eye ms-1"></i>تفاصيل</a>@if (canManage && (User.IsInRole("Admin") || course.InstructorId.ToString() == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)) { <a class="btn btn-sm btn-light" asp-action="Edit" asp-route-id="@course.Id"><i class="bi bi-pencil ms-1"></i>تعديل</a> }</div></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="surface-card empty-state"><i class="bi bi-search"></i><h3 class="mt-3">لم نجد كورسات مطابقة</h3><p>جرّب عبارة بحث مختلفة أو عد إلى القائمة الكاملة.</p><a class="btn btn-primary" asp-action="Index">عرض كل الكورسات</a></div>
}
