@model CourseManagement.API.Mvc.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "تغيير كلمة المرور";
}

<div class="breadcrumbs"><a asp-controller="Home" asp-action="Index">الرئيسية</a><i class="bi bi-chevron-left mx-2"></i>أمان الحساب</div>
<div class="page-heading mb-4"><div><div class="section-kicker">أمان الحساب</div><h1>تغيير كلمة المرور</h1><p>حدّث كلمة المرور بانتظام. بعد النجاح سيتم إنهاء الجلسة الحالية لتأمين الحساب.</p></div><span class="security-pill"><i class="bi bi-shield-check ms-1"></i>جلسة محمية</span></div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="surface-card form-card">
            <div class="card-header-soft mb-4"><h2 class="section-title mb-1">بيانات الدخول الجديدة</h2><p class="text-muted small mb-0">لا تشارك كلمة المرور مع أي شخص، حتى لو طلبها منك.</p></div>
            <form asp-action="ChangePassword" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3"><label asp-for="CurrentPassword" class="form-label"></label><input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" /><span asp-validation-for="CurrentPassword" class="text-danger"></span></div>
                <div class="mb-3"><label asp-for="NewPassword" class="form-label"></label><input asp-for="NewPassword" class="form-control" autocomplete="new-password" /><div class="input-hint"><i class="bi bi-info-circle ms-1"></i>استخدم 12 حرفًا على الأقل مع مزيج من الحروف والأرقام والرموز.</div><span asp-validation-for="NewPassword" class="text-danger"></span></div>
                <div class="mb-4"><label asp-for="ConfirmNewPassword" class="form-label"></label><input asp-for="ConfirmNewPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmNewPassword" class="text-danger"></span></div>
                <div class="d-flex gap-2"><button type="submit" class="btn btn-primary"><i class="bi bi-shield-lock ms-2"></i>حفظ كلمة المرور</button><a asp-controller="Home" asp-action="Index" class="btn btn-light">إلغاء</a></div>
            </form>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="security-card h-100"><span class="security-card-icon"><i class="bi bi-shield-check"></i></span><h2 class="h5 mt-4">لماذا ننهي الجلسة؟</h2><p class="text-white-50">تدوير Security Stamp ينهي الجلسات القديمة ويقلل مخاطر استخدام بيانات دخول سابقة.</p><div class="security-list"><span><i class="bi bi-check2-circle"></i>جلسات قديمة غير صالحة</span><span><i class="bi bi-check2-circle"></i>كلمة مرور فريدة أفضل</span><span><i class="bi bi-check2-circle"></i>حماية مستمرة للحساب</span></div></div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
