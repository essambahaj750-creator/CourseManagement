@model RegisterViewModel
@{
    ViewData["Title"] = "إضافة مستخدم";
}
<div class="page-heading"><div><h1>إضافة مستخدم</h1><p>أنشئ حسابًا جديدًا للمنصة.</p></div><a class="btn btn-outline-secondary" asp-action="Users">إلغاء</a></div>
<div class="surface-card form-card">
    <form asp-action="CreateUser" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
        <div class="mb-3"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName" class="text-danger small"></span></div>
        <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger small"></span></div>
        <div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" /><span asp-validation-for="Password" class="text-danger small"></span></div>
        <div class="mb-4"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" /><span asp-validation-for="ConfirmPassword" class="text-danger small"></span></div>
        <button class="btn btn-primary" type="submit">إنشاء المستخدم</button>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
